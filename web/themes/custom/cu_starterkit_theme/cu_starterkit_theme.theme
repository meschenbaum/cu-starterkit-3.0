<?php

/**
 * @file
 * Functions to support theming.
 */

use Drupal\block\Entity\Block;
use Drupal\cu_starterkit_theme\SettingsManager;
use Drupal\cu_starterkit_theme\SubthemeManager;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\views\ViewExecutable;
use Drupal\Core\Template\Attribute;
use PhpParser\Node\Expr\Cast\Array_;

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function cu_starterkit_theme_theme_suggestions_page_alter(array &$suggestions, array $variables) {

  if (isset($_GET['styleguide'])) {
    $suggestions[] = 'page__styleguide';
  }

  if (isset($variables['attributes']['data-block']['region'])) {
    $region = $variables['attributes']['data-block']['region'];
    $suggestions[] = $variables['theme_hook_original'] . '__' . $region;
    $suggestions[] = 'menu__' . $region;
  }

  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    $content_type = $node->bundle();
    $suggestions[] = 'page__'.$content_type;
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function cu_starterkit_theme_form_system_theme_settings_alter(&$form, FormStateInterface $form_state, $form_id = NULL) {
  $settings_manager = new SettingsManager(\Drupal::service('theme.manager'));
  return $settings_manager->themeSettingsAlter($form, $form_state, $form_id);
}

/**
 * Validate callback to ensure filter order and allowed_html are compatible.
 */
function cu_starterkit_theme_form_system_theme_settings_subtheme_validate(array &$form, FormStateInterface $form_state) {
  $subtheme_manager = new SubthemeManager(\Drupal::service('file_system'), \Drupal::service('messenger'));
  return $subtheme_manager->validateForm($form, $form_state);
}

/**
 * Form submission handler for node_form().
 *
 * @see cu_starterkit_theme_form_system_theme_settings_alter()
 */
function cu_starterkit_theme_form_system_theme_settings_subtheme_submit($form, FormStateInterface $form_state) {
  $subtheme_manager = new SubthemeManager(\Drupal::service('file_system'), \Drupal::service('messenger'));
  return $subtheme_manager->submitForm($form, $form_state);
}

/**
* Implements hook_page_attachments_alter().
*/
function cu_starterkit_theme_page_attachments_alter(array &$attachments) {
  // Remove Generator metadata
  foreach ($attachments["#attached"]["html_head"] as $key => $attachment) {
    if ($attachment[0]["#tag"] === 'meta' && !empty($attachment[0]["#attributes"]["name"]) && $attachment[0]["#attributes"]["name"] === 'Generator') {
      unset($attachments["#attached"]["html_head"]["$key"]);
    }
  }

  if ( (\Drupal::moduleHandler()->moduleExists('pantheon_domain_masking') && \Drupal::config('pantheon_domain_masking.settings')->get('enabled')) 
    && (isset($_ENV['PANTHEON_ENVIRONMENT']) && php_sapi_name() != 'cli') && $_ENV['PANTHEON_ENVIRONMENT'] == 'live' ) {
      $subPath = '/' . \Drupal::config('pantheon_domain_masking.settings')->get('subpath');
  } else {
    $subPath = '';
  }

  // Set favicons
  foreach ($attachments["#attached"]["html_head_link"] as $key => $attachment) {
    if ($attachment[0]["rel"] === 'icon') {
      unset($attachments["#attached"]["html_head_link"]["$key"]);
    }
  }
  $favicon_links = array(
    array(
      array(
        'rel' => 'apple-touch-icon',
        'href' => $subPath . '/themes/custom/cu_starterkit_theme/images/apple-touch-icon.png?v=2',
        'sizes' => '180x180'
      ),
    ),
    array(
      array(
        'rel' => 'icon',
        'href' => $subPath . '/themes/custom/cu_starterkit_theme/images/favicon-32x32.png?v=2',
        'sizes' => '32x32',
      'type' => 'image/png'
      ),
    ),
    array(
      array(
        'rel' => 'icon',
        'href' => $subPath . '/themes/custom/cu_starterkit_theme/images/favicon-16x16.png?v=2',
        'sizes' => '16x16',
        'type' => 'image/png'
      ),
    ),
    array(
      array(
        'rel' => 'manifest',
        'href' => $subPath . '/themes/custom/cu_starterkit_theme/images/site.webmanifest?v=2'
      ),
    ),
    array(
      array(
        'rel' => 'mask-icon',
        'href' => $subPath . '/themes/custom/cu_starterkit_theme/images/safari-pinned-tab.svg?v=2',
        'color' => '#cfb87c'
      ),
    ),
    array(
      array(
        'rel' => 'shortcut icon',
        'href' => $subPath . '/themes/custom/cu_starterkit_theme/favicon.ico?v=2',
      ),
    ),
  );
  $favicon_meta = array(
    '#type' => 'html_tag',
    '#tag' => 'meta',
    '#attributes' => array(
      'name' => 'msapplication-TileColor',
      'content' => '#cfb87c'
    ),
  );
  $favicon_meta_1 = array(
    '#type' => 'html_tag',
    '#tag' => 'meta',
    '#attributes' => array(
      'name' => 'msapplication-config',
      'content' => $subPath . '/themes/custom/cu_starterkit_theme/images/browserconfig.xml?v=2'
    ),
  );
  $favicon_meta_2 = array(
    '#type' => 'html_tag',
    '#tag' => 'meta',
    '#attributes' => array(
      'name' => 'theme-color',
      'content' => '#cfb87c'
    ),
  );
  $attachments['#attached']['html_head_link'] = $favicon_links;
  $attachments['#attached']['html_head'][] = [$favicon_meta, 'msapplicationTileColor'];
  $attachments['#attached']['html_head'][] = [$favicon_meta_1, 'msapplicationConfig'];
  $attachments['#attached']['html_head'][] = [$favicon_meta_2, 'themeColor'];
}

 /**
 * Implements hook_preprocess_HOOK() for HTML document templates.
 *
 * Adds body classes if certain regions have content.
 */
function cu_starterkit_theme_preprocess_html(&$variables) {
  // So fonts can be preloaded from base theme in the event Olivero is used as a subtheme.
  $variables['cuskt_path'] = \Drupal::request()->getBasePath() . '/' . \Drupal::service('extension.list.theme')->getPath('cu_starterkit_theme');

  // Site branding
  $variables['cuskt_branding'] = theme_get_setting('cuskt_branding');
  // Body color theme.
  $variables['cuskt_body_schema'] = theme_get_setting('cuskt_body_schema');
  $variables['cuskt_body_bg_schema'] = theme_get_setting('cuskt_body_bg_schema');
}

/**
 * Implements theme_preprocess_page().
 */
function cu_starterkit_theme_preprocess_page(&$variables) {
  // Pass variables to theme.
  $variables['cuskt_top_container'] = theme_get_setting('cuskt_top_container');
  // Navbar color theme.
  $variables['cuskt_navbar_global_schema'] = theme_get_setting('cuskt_navbar_global_schema');
  $variables['cuskt_navbar_bg_global_schema'] = theme_get_setting('cuskt_navbar_bg_global_schema');
  $variables['cuskt_navbar_local_schema'] = theme_get_setting('cuskt_navbar_local_schema');
  $variables['cuskt_navbar_bg_local_schema'] = theme_get_setting('cuskt_navbar_bg_local_schema');
  $variables['cuskt_navbar_main_schema'] = theme_get_setting('cuskt_navbar_main_schema');
  $variables['cuskt_navbar_bg_main_schema'] = theme_get_setting('cuskt_navbar_bg_main_schema');
  // Footer color theme.
  $variables['cuskt_footer_global_schema'] = theme_get_setting('cuskt_footer_global_schema');
  $variables['cuskt_footer_bg_global_schema'] = theme_get_setting('cuskt_footer_bg_global_schema');
  $variables['cuskt_footer_local_schema'] = theme_get_setting('cuskt_footer_local_schema');
  $variables['cuskt_footer_bg_local_schema'] = theme_get_setting('cuskt_footer_bg_local_schema');
  // Search settings
  $variables['cuskt_search_type'] = theme_get_setting('cuskt_search_type');
  $variables['cuskt_search_action'] = theme_get_setting('cuskt_search_action');
  $variables['cuskt_search_input_name'] = theme_get_setting('cuskt_search_input_name');
  if ( $variables['cuskt_search_type'] == 'local' && \Drupal::moduleHandler()->moduleExists('search')) {
    $variables['local_search'] = true;
  } else {
    $variables['local_search'] = false;
  }
  // Landing Page
  $variables['is_landing_page'] = (isset($variables['node']) && $variables['node']->hasField('field_landing_page')) ? $variables['node']->get('field_landing_page')->getValue()[0]['value'] : '0';
}

/**
 * Implements theme_preprocess_node__().
 */
function cu_starterkit_theme_preprocess_node__page(&$variables) {
  // Landing Page
  $variables['is_landing_page'] = (isset($variables['node']) && $variables['node']->hasField('field_landing_page')) ? $variables['node']->get('field_landing_page')->getValue()[0]['value'] : '0';
}
/**
 * Implements theme_preprocess_region__hero().
 */
function cu_starterkit_theme_preprocess_views_view_fields__page_hero__block(&$variables) {
  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    $variables['page_type'] = $node->bundle();
  }
}

/**
 * Implements hook_preprocess_breadcrumb().
 */
function cu_starterkit_theme_preprocess_breadcrumb(&$variables) {
  if ($variables['breadcrumb']) {
    $request = \Drupal::request();
    $route_match = \Drupal::routeMatch();
    $page_title = \Drupal::service('title_resolver')->getTitle($request, $route_match->getRouteObject());
    
    if (!empty($page_title)) {
      $variables['breadcrumb'][] = [
        'text' => $page_title
      ];
    }
    $variables['#cache']['contexts'][] = 'url';
  }
}

/**
 * Implements theme_preprocess_node__().
 */
function cu_starterkit_theme_preprocess_node__article_list(&$variables) {
  $variables['filter_by_category'] = Array();
  $variables['filter_by_tag'] = Array();
  $variables['exclude_category'] = Array();
  $variables['exclude_tag'] = Array();

  // Filter by Category
  $termsFiltCat = $variables['node']->get('field_filter_by_category')->referencedEntities();
  foreach ($termsFiltCat as $termFiltCat) {
    $variables['filter_by_category'][] = $termFiltCat->id();
  }
  //$variables['filter_by_category'] = implode(',', $variables['filter_by_category']);

  // Filter by Tag
  $termsFiltTag = $variables['node']->get('field_filter_by_tag')->referencedEntities();
  foreach ($termsFiltTag as $termFiltTag) {
    $variables['filter_by_tag'][] = $termFiltTag->id();
  }
  //$variables['filter_by_tag'] = implode(',', $variables['filter_by_tag']);

  // Exclude by Category
  $termsExCat = $variables['node']->get('field_exclude_category')->referencedEntities();
  foreach ($termsExCat as $termExCat) {
    $variables['exclude_category'][] = $termExCat->id();
  }
  //$variables['exclude_category'] = implode(',', $variables['exclude_category']);

  // Exclude by Tag
  $termsExTag = $variables['node']->get('field_exclude_tag')->referencedEntities();
  foreach ($termsExTag as $termExTag) {
    $variables['exclude_tag'][] = $termExTag->id();
  }
  //$variables['exclude_tag'] = implode(',', $variables['exclude_tag']);

  // Set domain masking subpath if being used(on Pantheon) - needed for json:api path alias use: https://gitlab.com/universityofcolorado/uis/webapps/shared-code/cu-starterkit-project-3.0/-/issues/75
  $variables['cuskt_domain_masking_subpath'] = '';
  if (isset($_ENV['HTTP_X_MASKED_PATH']) && $_ENV['HTTP_X_MASKED_PATH']) {
    $variables['cuskt_domain_masking_subpath'] = $_ENV['HTTP_X_MASKED_PATH'];
  }
}

/**
 * Implements hook_preprocess_HOOK() for menu-local-tasks templates.
 *
 * Use preprocess hook to set #attached to child elements
 * because they will be processed by Twig and drupal_render will
 * be invoked.
 */
function cu_starterkit_theme_preprocess_menu_local_tasks(&$variables) {
  if (!empty($variables['primary'])) {
    $variables['primary']['#attached'] = [
      'library' => [
        'cu_starterkit_theme/drupal.nav-tabs',
      ],
    ];
  }
  elseif (!empty($variables['secondary'])) {
    $variables['secondary']['#attached'] = [
      'library' => [
        'cu_starterkit_theme/drupal.nav-tabs',
      ],
    ];
  }

  foreach (Element::children($variables['primary']) as $key) {
    $variables['primary'][$key]['#level'] = 'primary';
  }
  foreach (Element::children($variables['secondary']) as $key) {
    $variables['secondary'][$key]['#level'] = 'secondary';
  }
}

/**
 * Implements hook_preprocess_HOOK() for menu-local-task templates.
 */
function cu_starterkit_theme_preprocess_menu_local_task(&$variables) {
  // Ensure is-active class is set when the tab is active. The generic active
  // link handler applies stricter comparison rules than what is necessary for
  // tabs.
  if (isset($variables['is_active']) && $variables['is_active'] === TRUE) {
    $variables['link']['#options']['attributes']['class'][] = 'nav-link active is-active';
  }
  else {
    $variables['link']['#options']['attributes']['class'][] = 'nav-link';
  }

  if (isset($variables['element']['#level'])) {
    $variables['level'] = $variables['element']['#level'];
  }
}

/**
 * Callback to convert attributes class which is string to array.
 *
 * @param array $variables
 *   The variables to render from preprocess function.
 */
function _cu_starterkit_theme_attributes_class_string_to_array(&$variables) {
  if (isset($variables['attributes']) &&
    isset($variables['attributes']['class']) &&
    !is_array($variables['attributes']['class'])) {
    $variables['attributes']['class'] = [$variables['attributes']['class']];
  }
}

/**
 * Implements theme_preprocess_textarea().
 */
function cu_starterkit_theme_preprocess_textarea(&$variables) {
  _cu_starterkit_theme_attributes_class_string_to_array($variables);
  $variables['attributes']['class'][] = 'form-control';
}

/**
 * Implements template_preprocess_HOOK() for input.
 */
function cu_starterkit_theme_preprocess_input(&$variables) {
  _cu_starterkit_theme_attributes_class_string_to_array($variables);

  $type_html = $variables['attributes']['type'];
  $text_types_html = [
    'text',
    'email',
    'tel',
    'number',
    'search',
    'password',
    'url',
    'month',
    'week',
    'date',
    'time',
  ];

  if (in_array($type_html, $text_types_html)) {
    $variables['attributes']['class'][] = 'form-control';
  }

  if (in_array($type_html, ['checkbox'])) {
    $variables['attributes']['class'][] = 'form-check-input';
  }
}

/**
 * Implements theme_preprocess_datetime_form().
