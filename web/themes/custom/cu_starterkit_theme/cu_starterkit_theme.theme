/**
 * Implements hook_views_pre_render().
 */
function cu_starterkit_theme_views_pre_render(ViewExecutable $view) {
  $add_classes = function (&$option, array $classes_to_add) {
    $classes = preg_split('/\s+/', $option);
    $classes = array_filter($classes);
    $classes = array_merge($classes, $classes_to_add);
    $option = implode(' ', array_unique($classes));
  };

  if ($view->id() === 'media_library') {
    if ($view->display_handler->options['defaults']['css_class']) {
      $add_classes($view->displayHandlers->get('default')->options['css_class'], ['media-library-view']);
    } else {
      $add_classes($view->display_handler->options['css_class'], ['media-library-view']);
    }

    if ($view->current_display === 'page') {
      if (array_key_exists('media_bulk_form', $view->field)) {
        $add_classes($view->field['media_bulk_form']->options['element_class'], ['media-library-item__click-to-select-checkbox']);
      }
      if (array_key_exists('rendered_entity', $view->field)) {
        $add_classes($view->field['rendered_entity']->options['element_class'], ['media-library-item__content']);
      }
      if (array_key_exists('edit_media', $view->field)) {
        $add_classes($view->field['edit_media']->options['alter']['link_class'], ['media-library-item__edit']);
        $add_classes($view->field['edit_media']->options['alter']['link_class'], ['icon-link']);
      }
      if (array_key_exists('delete_media', $view->field)) {
        $add_classes($view->field['delete_media']->options['alter']['link_class'], ['media-library-item__remove']);
        $add_classes($view->field['delete_media']->options['alter']['link_class'], ['icon-link']);
      }
    } elseif (strpos($view->current_display, 'widget') === 0) {
      if (array_key_exists('rendered_entity', $view->field)) {
        $add_classes($view->field['rendered_entity']->options['element_class'], ['media-library-item__content']);
      }
      if (array_key_exists('media_library_select_form', $view->field)) {
        $add_classes($view->field['media_library_select_form']->options['element_wrapper_class'], ['media-library-item__click-to-select-checkbox']);
      }

      if ($view->display_handler->options['defaults']['css_class']) {
        $add_classes($view->displayHandlers->get('default')->options['css_class'], ['media-library-view--widget']);
      } else {
        $add_classes($view->display_handler->options['css_class'], ['media-library-view--widget']);
      }
    }
  }
}

/**
 * Implements hook_preprocess_media_library_item__widget().
 *
 * This targets each media item selected in an entity reference field.
 */
function cu_starterkit_theme_preprocess_media_library_item__widget(array &$variables) {
  $variables['content']['remove_button']['#attributes']['class'][] = 'media-library-item__remove';
  $variables['content']['remove_button']['#attributes']['class'][] = 'icon-link';
}

/**
 * Implements hook_preprocess_HOOK().
 *
 * Pass block region value to content so this can be used in
 * THEME_theme_suggestions_menu_alter.
 */
function cu_starterkit_theme_preprocess_block(&$variables) {
  if (isset($variables['elements']['#id'])) {
    $block = Block::load($variables['elements']['#id']);
    if ($block) {
      $region = Block::load($variables['elements']['#id'])->getRegion();
      if (!empty($region)) {
        $variables['content']['#attributes']['data-block']['region'] = $region;
      }
    }
  }

  // System Branding Block
  if ($variables['base_plugin_id'] == 'system_branding_block') {
    switch (theme_get_setting('cuskt_navbar_bg_global_schema')) {
      case 'none':
      case 'light':
        $variables['logo_theme'] = 'light';
        break;
      default:
        $variables['logo_theme'] = 'dark';
    }

    if ( (\Drupal::moduleHandler()->moduleExists('pantheon_domain_masking') && \Drupal::config('pantheon_domain_masking.settings')->get('enabled')) 
      && (isset($_ENV['PANTHEON_ENVIRONMENT']) && php_sapi_name() != 'cli') && $_ENV['PANTHEON_ENVIRONMENT'] == 'live' ) {
        $variables['subPath'] = '/' . \Drupal::config('pantheon_domain_masking.settings')->get('subpath');
    } else {
      $variables['subPath'] = '';
    }

    $variables['cuskt_branding_logo_use_svg_sprite'] = theme_get_setting('cuskt_branding_logo_use_svg_sprite');
    $variables['cuskt_branding_logo_mobile_sprite_path'] = theme_get_setting('cuskt_branding_logo_mobile_sprite_path');
    $variables['cuskt_branding_logo_desktop_sprite_path'] = theme_get_setting('cuskt_branding_logo_desktop_sprite_path');
    // Landing Page
    if ($node = \Drupal::routeMatch()->getParameter('node')) {
      $variables['is_landing_page'] = ($node->hasField('field_landing_page')) ? $node->get('field_landing_page')->getValue()[0]['value'] : '0';
    } else {
      $variables['is_landing_page'] = '0';
    }
  }
}

/**
 * Implements hook_preprocess_paragraph__cuskt_layout_hero()
 */
function cu_starterkit_theme_preprocess_paragraph__cuskt_layout_hero(&$variables) {
  $paragraph = $variables['elements']['#paragraph'];
  $variables['bg_color'] = $paragraph->hasField('field_background_color') ? $paragraph->get('field_background_color')->value : '';
  $variables['text_color'] = $paragraph->hasField('field_text_color') ? $paragraph->get('field_text_color')->value : '';
  $variables['margin_top'] = $paragraph->hasField('field_margin_top') ? $paragraph->get('field_margin_top')->value : '';
  $variables['margin_bottom'] = $paragraph->hasField('field_margin_bottom') ? $paragraph->get('field_margin_bottom')->value : '';
  $variables['padding_top'] = $paragraph->hasField('field_padding_top') ? $paragraph->get('field_padding_top')->value : '';
  $variables['padding_bottom'] = $paragraph->hasField('field_padding_bottom') ? $paragraph->get('field_padding_bottom')->value : '';
  // Add layout setting to region for handling by layout twig
  $variables['content']['regions']['#settings']['cuskt_column_setting'] = $paragraph->hasField('field_column_layout_setting_hero') ? $paragraph->get('field_column_layout_setting_hero')->value : '';
}

/**
 * Implements hook_preprocess_paragraph__cuskt_layout()
 */
function cu_starterkit_theme_preprocess_paragraph__cuskt_layout(&$variables) {
  $paragraph = $variables['elements']['#paragraph'];
  $variables['bg_color'] = $paragraph->hasField('field_background_color') ? $paragraph->get('field_background_color')->value : '';
  $variables['text_color'] = $paragraph->hasField('field_text_color') ? $paragraph->get('field_text_color')->value : '';
  $variables['margin_top'] = $paragraph->hasField('field_margin_top') ? $paragraph->get('field_margin_top')->value : '';
  $variables['margin_bottom'] = $paragraph->hasField('field_margin_bottom') ? $paragraph->get('field_margin_bottom')->value : '';
  $variables['padding_top'] = $paragraph->hasField('field_padding_top') ? $paragraph->get('field_padding_top')->value : '';
  $variables['padding_bottom'] = $paragraph->hasField('field_padding_bottom') ? $paragraph->get('field_padding_bottom')->value : '';
  // Add layout setting to region for handling by layout twig
  $variables['content']['regions']['#settings']['cuskt_column_setting'] = $paragraph->hasField('field_column_layout_setting') ? $paragraph->get('field_column_layout_setting')->value : '';
}

/**
 * Implements hook_preprocess_paragraph__content_media()
 */
function cu_starterkit_theme_preprocess_paragraph__content_media(&$variables) {
  $paragraph = $variables['elements']['#paragraph'];
  $variables['is_figure'] = ($paragraph->hasField('field_text') && $paragraph->get('field_text')->value) ? true : false;
  $variables['caption_align'] = $paragraph->hasField('field_text_alignment') ? $paragraph->get('field_text_alignment')->value : '';
}

/**
 * Implements hook_preprocess_paragraph__content_horizontal_rule()
 */
function cu_starterkit_theme_preprocess_paragraph__content_horizontal_rule(&$variables) {
  $paragraph = $variables['elements']['#paragraph'];
  $variables['border_color'] = $paragraph->hasField('field_border_color') ? $paragraph->get('field_border_color')->value : '';
  $variables['padding_tb'] = $paragraph->hasField('field_padding_top_bottom') ? $paragraph->get('field_padding_top_bottom')->value : '';
}

/**
 * Implements hook_preprocess_paragraph__content_list()
 */
function cu_starterkit_theme_preprocess_paragraph__content_list(&$variables) {
  $paragraph = $variables['elements']['#paragraph'];
  $variables['list_count'] = $paragraph->hasField('field_paragraph') ? $paragraph->get('field_paragraph')->count() : '0';
  // Need to build media  as it no longer done in Layout Paragraphs/Paragraphs
  if ($variables['list_count']) {
    $listItems = $paragraph->get('field_paragraph')->referencedEntities();
    foreach($listItems as $key => $item){
      $build = \Drupal::entityTypeManager()->getViewBuilder('media')->view($item->get('field_media')[0]->entity);
      $variables['list_items'][$key]['content'] = $item;
      $variables['list_items'][$key]['media'] = $build;
    }
  } else {
    $variables['list_items'] = [];
  }
  $variables['list_layout_type'] = $paragraph->hasField('field_list_layout_type') ? $paragraph->get('field_list_layout_type')->value : '';
  $variables['list_item_divider'] = $paragraph->hasField('field_boolean') ? $paragraph->get('field_boolean')->value : '';
  $variables['list_item_margin'] = $paragraph->hasField('field_margin_bottom') ? $paragraph->get('field_margin_bottom')->value : '';
}

/**
 * Implements hook_preprocess_paragraph__content_list_styled_order()
 */
function cu_starterkit_theme_preprocess_paragraph__content_list_styled_order(&$variables) {
  $paragraph = $variables['elements']['#paragraph'];
  $variables['list_count'] = $paragraph->hasField('field_paragraph') ? $paragraph->get('field_paragraph')->count() : '0';
  $variables['list_style'] = $paragraph->hasField('field_list_style') ? $paragraph->get('field_list_style')->value : 'primary';
  $variables['list_size'] = $paragraph->hasField('field_list_size') ? $paragraph->get('field_list_size')->value : 'small';
}


/**
 * Implements hook_preprocess_paragraph__content_accordion()
 */
function cu_starterkit_theme_preprocess_paragraph__content_accordion(&$variables) {
  $paragraph = $variables['elements']['#paragraph'];
  $variables['list_count'] = $paragraph->hasField('field_paragraph') ? $paragraph->get('field_paragraph')->count() : '0';
}

/**
 * Implements hook_preprocess_paragraph__content_card()
 */
function cu_starterkit_theme_preprocess_paragraph__content_card(&$variables) {
  $paragraph = $variables['elements']['#paragraph'];
  // Overlay
  $variables['is_overlay'] = $paragraph->hasField('field_boolean_3') ? $paragraph->get('field_boolean_3')->value : '';
  $variables['overlay_link'] = ($paragraph->hasField('field_link') && $paragraph->get('field_link')->first()) ? $paragraph->get('field_link')->first()->getUrl() : '';
  $variables['overlay_link_title'] = ($paragraph->hasField('field_link') && $paragraph->get('field_link')->first()) ? $paragraph->get('field_link')->first()->title : '';
  $variables['text_color'] = $paragraph->hasField('field_text_color') ? $paragraph->get('field_text_color')->value : '';
  // Header/Footer
  $variables['card_header_bg_color'] = $paragraph->hasField('field_background_color_2') ? $paragraph->get('field_background_color_2')->value : '';
  $variables['card_footer_bg_color'] = $paragraph->hasField('field_background_color') ? $paragraph->get('field_background_color')->value : '';
  // Button
  $variables['button_color'] = $paragraph->hasField('field_button_color') ? $paragraph->get('field_button_color')->value : '';
  $variables['button_link'] = ($paragraph->hasField('field_link_2') && $paragraph->get('field_link_2')->first()) ? $paragraph->get('field_link_2')->first()->getUrl() : '';
  $variables['button_link_text'] = ($paragraph->hasField('field_link_2') && $paragraph->get('field_link_2')->first()) ? $paragraph->get('field_link_2')->first()->title : '';
  $variables['button_link_title'] = ($paragraph->hasField('field_link_2') && $paragraph->get('field_link_2')->first() && isset($paragraph->get('field_link_2')->first()->get('options')->getValue()['attributes']['title'])) ? $paragraph->get('field_link_2')->first()->get('options')->getValue()['attributes']['title'] : '';
  $variables['button_center'] = $paragraph->hasField('field_boolean_2') ? $paragraph->get('field_boolean_2')->value : '';
  // Image
  $variables['card_image_position'] = $paragraph->hasField('field_card_image_position') ? $paragraph->get('field_card_image_position')->value : '';
  // Styles
  $variables['text_alignment'] = $paragraph->hasField('field_boolean_4') ? $paragraph->get('field_boolean_4')->value : '';
  $variables['border_color'] = $paragraph->hasField('field_border_color') ? $paragraph->get('field_border_color')->value : '';
  $variables['card_horizontal_rule'] = $paragraph->hasField('field_boolean') ? $paragraph->get('field_boolean')->value : '';
}

/**
 * Implements hook_preprocess_paragraph__content_quote()
 */
function cu_starterkit_theme_preprocess_paragraph__content_quote(&$variables) {
  $paragraph = $variables['elements']['#paragraph'];
  $variables['image_position'] = $paragraph->hasField('field_boolean_left_right') ? $paragraph->get('field_boolean_left_right')->value : '';
  $variables['text_alignment'] = $paragraph->hasField('field_text_alignment') ? $paragraph->get('field_text_alignment')->value : '';
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function cu_starterkit_theme_theme_suggestions_menu_alter(array &$suggestions, array $variables) {
  if (isset($variables['attributes']['data-block']['region'])) {
    $region = $variables['attributes']['data-block']['region'];
    $suggestions[] = $variables['theme_hook_original'] . '__' . $region;
    $suggestions[] = 'menu__' . $region;
  }
}
